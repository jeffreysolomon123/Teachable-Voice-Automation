# Required: OpenRouter key used for UI segmentation (stage 3). API_KEY= is also accepted.
OPENROUTER_API_KEY=
# Optional (defaults shown)
SEG_MODEL=google/gemini-2.5-flash-lite
SEG_CONCURRENCY=8
SEG_MAX_SIDE=0
SEG_JPEG_QUALITY=85
SEG_RETRIES=4
MAX_CONCURRENT_JOBS=1
MAX_UPLOAD_MB=300
JOB_TTL_HOURS=24
# RUNS_DIR=./runs
# If set, clients must send header  X-API-Key: <value>  (everything except /health)
SERVICE_API_KEY=
