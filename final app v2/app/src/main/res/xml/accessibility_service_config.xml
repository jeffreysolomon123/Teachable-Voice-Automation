<?xml version="1.0" encoding="utf-8"?>
<!--
  REPLAY is screenshot-only: it never inspects AccessibilityNodeInfo. It uses:
    - window-state events (package name) to know when a launched app has settled
    - takeScreenshot()                               (canTakeScreenshot, API 30+)
    - dispatchGesture() coordinate taps/swipes       (canPerformGestures)
    - performGlobalAction(GLOBAL_ACTION_BACK)
    - InputMethod.commitText() into the focused field (flagInputMethodEditor, API 33+)
  TEACH recording additionally logs UI events (typeAllMask, canRetrieveWindowContent,
  flagRetrieveInteractiveWindows for the keyboard window, flagReportViewIds) into the tap log that
  tells the video pipeline when and where each tap happened. Nothing is logged outside a recording.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagInputMethodEditor|flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:notificationTimeout="0"
    android:description="@string/accessibility_description" />
