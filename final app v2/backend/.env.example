# Copy to .env for local runs. On Render set these in the dashboard (never commit real values).
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated browser origins. Leave empty in production unless a web client needs access.
CORS_ORIGINS=

# --- Groq (text + vision LLM). Leave a model empty to disable that tier.
# Check available model IDs with: curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_API_KEY=
TEXT_MODEL=openai/gpt-oss-120b
TEXT_REASONING_EFFORT=low
VISION_MODEL=qwen/qwen3.8-27b
VISION_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=20

# --- Segmentation: pool | gemini | groq | hf_space | local | http
# "pool": combines Groq Vision (30 RPM) + Gemini Vision (15 RPM) for high throughput & automatic failover
SEGMENTATION_PROVIDER=pool
SEGMENTATION_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Gradio Space running cloud_gpu_ui_segmentation/hf_space/app.py (ID "user/name" or URL)
HF_SPACE=
HF_TOKEN=
# SEGMENTATION_PROVIDER=http: an endpoint speaking cloud_gpu_ui_segmentation/server.py's /segment contract
SEGMENTATION_HTTP_URL=
SEGMENTATION_HTTP_TOKEN=
# SEGMENTATION_PROVIDER=local: folder with segment_ui.py / ocr_text.py / combine_results.py
LOCAL_SEGMENTATION_DIR=../tap-to-flow-pipeline/3_ui_segmentation

# --- Replay
MAX_RETRIES=3
MAX_SCROLL_ATTEMPTS=3
SCREEN_SETTLE_DELAY_MS=1000
LAUNCH_SETTLE_DELAY_MS=3000
CONFIRMATION_TTL_SECONDS=300
SESSION_TTL_SECONDS=1800

# --- Matching thresholds (0..1)
MATCH_CONFIDENT_THRESHOLD=0.80
MATCH_AMBIGUITY_MARGIN=0.08
LLM_CONFIDENCE_THRESHOLD=0.70
VISION_CONFIDENCE_THRESHOLD=0.70

# --- Uploads
MAX_IMAGE_BYTES=8388608

# --- Storage (mount a Render persistent disk here to keep flows created at runtime)
FLOWS_DIR=flows

# --- Voice assistant (assistant/voice_assistant_app) served at /api/voice and /mobile/
VOICE_ASSISTANT_ENABLED=true
VOICE_ASSISTANT_DIR=../assistant
# Where the assistant keeps workflow/session memory (default: assistant/voice_assistant_app/data)
VOICE_DATA_DIR=
# Optional Gemini fallback for the assistant's LLM/STT
GEMINI_API_KEY=
